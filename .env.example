# ── AI Provider ──────────────────────────────────────────────────────────────
# Choose "anthropic", "openai", or "ollama" (runs on this Mac)
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model overrides (defaults are sensible)
# AI_MODEL_ANTHROPIC=claude-opus-5-5
# AI_MODEL_OPENAI=gpt-4o
# Ollama's default depends on this Mac's memory; see src/therapy_notes/models.py
# OLLAMA_MODEL=qwen3.5:9b

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DURATION_MINUTES=55

# ── Transcription ─────────────────────────────────────────────────────────────
# auto: Parakeet on Apple Silicon, Whisper elsewhere or if Parakeet can't load.
# Or set: parakeet | faster-whisper
ASR_ENGINE=auto

# Whisper model, used only when Whisper runs. Default depends on this Mac's memory.
# tiny | base | small | medium | large-v3 | large-v3-turbo
# WHISPER_MODEL=large-v3-turbo

# ── Audio Devices ─────────────────────────────────────────────────────────────
# Leave blank to use the system default microphone.
# Run `python tools/list_audio_devices.py` to see available device names/indices.
AUDIO_PRIMARY_DEVICE=

# Optional: a loopback device to capture Zoom audio output (client's voice).
# macOS: install BlackHole 2ch, create a Multi-Output Device in Audio MIDI Setup,
#        then set AUDIO_LOOPBACK_DEVICE=BlackHole 2ch
# Windows: set AUDIO_LOOPBACK_DEVICE to your WASAPI loopback device name
AUDIO_LOOPBACK_DEVICE=

# ── Paths ─────────────────────────────────────────────────────────────────────
# Sessions default to ~/Library/Application Support/TherapyNotes/sessions
# SESSIONS_DIR=
TEMPLATE_FILE=./templates/notes_template.txt

# ── Privacy ───────────────────────────────────────────────────────────────────
# Delete a session's audio once its notes are saved. Failed sessions keep their
# audio so they can be retried.
DELETE_AUDIO_AFTER_NOTES=true

# Delete the raw (pre-anonymization) transcript once notes are saved.
DELETE_RAW_TRANSCRIPT=false
