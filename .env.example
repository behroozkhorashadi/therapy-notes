# ── AI Provider ──────────────────────────────────────────────────────────────
# Choose "anthropic" or "openai"
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Model overrides (defaults are sensible)
# AI_MODEL_ANTHROPIC=claude-sonnet-4-6
# AI_MODEL_OPENAI=gpt-4o

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DURATION_MINUTES=55

# ── Transcription ─────────────────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large-v3
# Tradeoff: larger = more accurate but slower to run
# Recommended starting point: base (fast) or small (better accuracy)
WHISPER_MODEL=small

# ── Audio Devices ─────────────────────────────────────────────────────────────
# Leave blank to use the system default microphone.
# Run `python tools/list_audio_devices.py` to see available device names/indices.
AUDIO_PRIMARY_DEVICE=

# Optional: a loopback device to capture Zoom audio output (client's voice).
# macOS: install BlackHole 2ch, create a Multi-Output Device in Audio MIDI Setup,
#        then set AUDIO_LOOPBACK_DEVICE=BlackHole 2ch
# Windows: set AUDIO_LOOPBACK_DEVICE to your WASAPI loopback device name
AUDIO_LOOPBACK_DEVICE=

# ── Paths ─────────────────────────────────────────────────────────────────────
SESSIONS_DIR=./sessions
TEMPLATE_FILE=./templates/notes_template.txt

# ── Privacy ───────────────────────────────────────────────────────────────────
# Delete the raw audio WAV after transcription is complete (saves disk space).
# The anonymized transcript and notes are always kept.
DELETE_AUDIO_AFTER_TRANSCRIPTION=false

# Delete the raw (pre-anonymization) transcript after anonymization.
DELETE_RAW_TRANSCRIPT=false
